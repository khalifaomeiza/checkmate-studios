{
  "name": "checkmate-studios",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Checkmate Studios — premium design agency website (Vite + React + Supabase Edge Functions).",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "sync:wip": "bash scripts/sync-public-from-wip.sh",
    "upload:resource-zips": "node scripts/upload-resource-zips.mjs",
    "upload:resource-zips:missing": "node scripts/upload-resource-zips.mjs --only-missing",
    "fn:serve": "supabase functions serve --env-file ./supabase/.env.functions",
    "fn:deploy": "supabase functions deploy newsletter-subscribe contact-submit career-apply admin-signup case-study-media-upload case-study-delete",
    "fn:secrets": "node scripts/set-fn-secrets.mjs",
    "db:push": "bash scripts/db-push.sh",
    "db:push:api": "node scripts/apply-migrations-api.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "formik": "^2.4.6",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.30.3",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@aws-sdk/client-s3": "^3.967.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "cloudinary": "^2.10.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite-imagetools": "^8.0.0"
  }
}
