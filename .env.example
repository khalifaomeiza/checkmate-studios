
# Cloudinary (Node upload script — small .zips only, ~9 MiB max on free tier)
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# Or:
# CLOUDINARY_CLOUD_NAME="your_cloud"
# CLOUDINARY_API_KEY="..."
# CLOUDINARY_API_SECRET="..."
# Optional folder for raw .zip uploads (default: checkmate-studios/resource-zips)
# CLOUDINARY_RESOURCE_FOLDER="checkmate-studios/resource-zips"

# Cloudflare R2 — case study media + resource zips (S3 API from Dashboard → R2)
# CLOUDFLARE_S3_API="https://<account-id>.r2.cloudflarestorage.com"
# R2_ACCOUNT_ID="..."
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET="your-bucket-name"          # R2_BUCKET_NAME also accepted
# R2_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev"
# R2_CASE_STUDY_PREFIX="case-studies"   # object prefix for CMS uploads
# Optional: R2_OBJECT_PREFIX="resource-zips"

# Supabase project URL (public)
VITE_SUPABASE_URL="https://"

# Supabase anon key (public, RLS-protected)
VITE_SUPABASE_ANON_KEY="paste-anon-key-here"

# Vercel Cron — keep Supabase project alive (every ~5 days, see vercel.json)
# Auth falls back to VITE_SUPABASE_ANON_KEY when CRON_SECRET is unset.
# Optional override: CRON_SECRET="custom-secret"
# Optional on Vercel (server-only, recommended for keep-alive DB ping):
# SUPABASE_URL="https://xxxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Supabase CLI — Management API token (no database password needed)
# Create at: https://supabase.com/dashboard/account/tokens
# Then run: npm run db:push:api
SUPABASE_ACCESS_TOKEN="sbp_..."

# Supabase CLI only — must match Dashboard → Settings → Database → Database password
# Used by npm run db:push (direct Postgres — may fail on some networks)
SUPABASE_DB_PASSWORD="your-database-password"

# Local upload script only: large resource .zips → Storage (never ship to the browser)
# SUPABASE_URL="https://xxxxx.supabase.co"   (same project as VITE_SUPABASE_URL)
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# SUPABASE_RESOURCE_BUCKET="resource-zips"
# Optional: npm run upload:resource-zips -- --only-missing   (skip zips already in resourceZipUrls.generated.ts)
# Optional: npm run upload:resource-zips -- --force   (re-upload all)


STUDIOS_CHECKMATE_RESEND_API_KEY="re_..."
EMAIL_USER="hello@studio.com"
ADMIN_EMAIL_USER="admin@studio.com"
# Optional: override Cloudinary URLs used in Resend HTML (defaults match proposal template)
# EMAIL_LOGO_URL="https://res.cloudinary.com/.../logo.png"
# EMAIL_FOOTER_STRIP_URL="https://res.cloudinary.com/.../footer.png"
